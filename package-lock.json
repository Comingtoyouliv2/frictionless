{
  "name": "frictionless",
  "version": "0.1.0",
  "lockfileVersion": 2,
  "requires": true,
  "packages": {
    "": {
      "name": "frictionless",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "examples/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "examples/direct-swap-demo": {
      "name": "@frictionless/direct-swap-demo",
      "version": "0.1.0",
      "dependencies": {
        "@frictionless/protocol": "file:../../packages/frictionless-protocol",
        "@frictionless/provider-sdk": "file:../../packages/provider-sdk"
      }
    },
    "node_modules/@frictionless/direct-swap-demo": {
      "resolved": "examples/direct-swap-demo",
      "link": true
    },
    "node_modules/@frictionless/protocol": {
      "resolved": "packages/frictionless-protocol",
      "link": true
    },
    "node_modules/@frictionless/provider-sdk": {
      "resolved": "packages/provider-sdk",
      "link": true
    },
    "packages/frictionless-protocol": {
      "name": "@frictionless/protocol",
      "version": "0.1.0"
    },
    "packages/provider-sdk": {
      "name": "@frictionless/provider-sdk",
      "version": "0.1.0",
      "dependencies": {
        "@frictionless/protocol": "file:../frictionless-protocol"
      }
    }
  },
  "dependencies": {
    "@frictionless/direct-swap-demo": {
      "version": "file:examples/direct-swap-demo",
      "requires": {
        "@frictionless/protocol": "file:../../packages/frictionless-protocol",
        "@frictionless/provider-sdk": "file:../../packages/provider-sdk"
      }
    },
    "@frictionless/protocol": {
      "version": "file:packages/frictionless-protocol"
    },
    "@frictionless/provider-sdk": {
      "version": "file:packages/provider-sdk",
      "requires": {
        "@frictionless/protocol": "file:../frictionless-protocol"
      }
    }
  }
}
